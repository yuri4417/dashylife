{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dashylife": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/index.js"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DASHYLIFE_URL": "http://192.168.1.10:8081",
        "DASHYLIFE_API_KEY": ""
      }
    }
  }
}
